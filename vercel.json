{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm run build:vercel",
      "entrypoint": "index.mjs"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/((?!api/|assets/)[^.]*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "schedules": {
    "notifications": {
      "schedule": "*/15 * * * *",
      "path": "/api/cron/notifications",
      "requestMethod": "GET"
    }
  }
}
