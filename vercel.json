{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm run build:vercel",
      "entrypoint": "index.mjs"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build && cp dist/index.html dist/404.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/reservations",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/vehicles",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    },
    {
      "source": "/book",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/((?!assets/)[^.]*)",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
